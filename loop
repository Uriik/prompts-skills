/**
 * FRONTEND LOOP - Com Early Validator (Fail-Fast)
 */

const fs = require('fs');
const { execSync } = require('child_process');

class FrontendLoop {
  constructor(projectPath = '.') {
    this.projectPath = projectPath;
    this.maxIterations = 5;
    this.state = { iteration: 0, success: false };
  }

  async run(taskDescription) {
    console.log('\n🚀 INICIANDO FRONTEND LOOP...');

    // 1. Planejamento de UI/Estado (Opus)
    const plan = JSON.parse(await spawnAgent('planner', `Frontend Task: ${taskDescription}`));
    
    while (this.state.iteration < this.maxIterations && !this.state.success) {
      this.state.iteration++;
      console.log(`\n📍 ITERAÇÃO GLOBAL ${this.state.iteration}`);

      // ==========================================
      // ⭐ O MINI-LOOP: FRONT DEV + EARLY VALIDATOR
      // ==========================================
      let isUiLogicValid = false;
      let devAttempts = 0;
      let frontCode = "";

      while (!isUiLogicValid && devAttempts < 3) {
        devAttempts++;
        console.log(`\n  ⚙️ [Front-Dev] Construindo UI/State (Tentativa ${devAttempts})...`);
        frontCode = await spawnAgent('frontend-dev', `Task: ${taskDescription}`);

        console.log(`  🔍 [UI Validator] Checando contrato de API e requisitos visuais...`);
        // Usa Haiku para verificar rapidamente coisas como: "Adicionou o botão X?", "Está chamando a API certa?"
        const validationResult = JSON.parse(await spawnAgent('business-checker', 
          `Requisitos UI: ${taskDescription}\nCódigo: ${frontCode}\nOs requisitos visuais essenciais e as chamadas de API estão presentes? Responda JSON: { "pass": boolean, "reason": "string" }`
        ));

        if (validationResult.pass) {
          console.log('  ✅ [UI Validator] Componentes aprovados! Prosseguindo...');
          isUiLogicValid = true;
        } else {
          console.log(`  ❌ [UI Validator] Falha nos requisitos: ${validationResult.reason}`);
          taskDescription += `\n[CORREÇÃO UI OBRIGATÓRIA]: ${validationResult.reason}`;
        }
      }

      if (!isUiLogicValid) throw new Error("Front-Dev não atendeu aos requisitos básicos da interface.");

      // ==========================================
      // ESTEIRA NORMAL (Só executa se UI estiver OK)
      // ==========================================
      console.log('\n  🧹 [ESLint] Rodando formatador local...');
      try {
        execSync('npm run lint -- --fix', { cwd: this.projectPath });
      } catch (e) {
        // Se o linter não arrumar sozinho, chama o agente Linter Fixer
        await spawnAgent('linter', `Corrija estes erros de ESLint no código.`);
      }

      console.log('  🧪 [Tester] Criando testes React (Jest/Testing Library)...');
      const tests = await spawnAgent('tester', `Crie testes para o componente renderizado.`);

      // Roda testes locais
      try {
        execSync('npm test -- --watchAll=false', { cwd: this.projectPath });
      } catch (e) {
        console.log("  ⚠️ Testes falharam, QA reportará.");
      }

      console.log('  🕵️‍♂️ [Review + QA] Opus auditando hooks, acessibilidade e renderização...');
      const [reviewReport, qaReport] = await Promise.all([
        spawnAgent('reviewer', `Audite vazamentos de memória (useEffect), acessibilidade (a11y) e boas práticas React.`),
        spawnAgent('qa', `Analise cobertura e logs do Jest.`)
      ]);

      // ==========================================
      // ORQUESTRADOR: A DECISÃO FINAL
      // ==========================================
      console.log('  ⚖️ [Orquestrador] Julgando a feature de Front...');
      const decision = JSON.parse(await spawnAgent('orchestrator', 
        `UI Task: ${taskDescription}\nQA: ${qaReport}\nReview: ${reviewReport}\nJulgamento (STOP ou CONTINUE)?`
      ));

      if (decision.decision === 'STOP') {
        this.state.success = true;
        console.log('\n🎉 FRONTEND CONCLUÍDO COM SUCESSO!');
      } else {
        console.log(`\n⚠️ Loop continuará. Motivos: ${decision.reasons.join(', ')}`);
        taskDescription += `\nFix issues: ${decision.reasons.join(', ')}`;
      }
    }
  }
}

module.exports = { FrontendLoop };


