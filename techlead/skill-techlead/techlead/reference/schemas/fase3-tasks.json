{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fase 3 - Quebra em Tasks",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "objetivo", "depende_de", "decisoes_tomadas", "passos", "criterios_aceite", "arquivos_esperados", "regras"],
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "objetivo": { "type": "string" },
          "depende_de": { "type": "array", "items": { "type": "string" } },
          "decisoes_tomadas": { "type": "array", "items": { "type": "string" } },
          "passos": { "type": "array", "items": { "type": "string" } },
          "criterios_aceite": { "type": "array", "items": { "type": "string" } },
          "arquivos_esperados": { "type": "array", "items": { "type": "string" } },
          "regras": { "type": "array", "items": { "type": "string" } },
          "snippets": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
