# Credenciais individuais da StackSpot — copie para .env e preencha.
# NUNCA versione o .env (já está no .gitignore).
# Os valores de URL saem do curl que o portal StackSpot mostra ao criar o Agent.

STACKSPOT_IDM_TOKEN_URL="https://idm.stackspot.com/SEU_REALM/oidc/oauth/token"
STACKSPOT_AGENT_BASE_URL="https://genai-inference-app.stackspot.com"
STACKSPOT_CLIENT_ID="seu_client_id"
STACKSPOT_CLIENT_SECRET="seu_client_secret"
STACKSPOT_AGENT_ID="id_do_agent_techlead_core"
